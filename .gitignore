# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Vector Stores & Databases
vector_store/
chroma_db/
*.faiss
*.index
*.sqlite3

# Personal Chat Data (Privacy First - Do NOT commit raw personal chats)
data/raw/**
data/raw_real/**
data/processed/**
!data/raw/.gitkeep
!data/raw_real/.gitkeep
!data/processed/.gitkeep
!data/raw/sample_chat.txt
!data/raw_real/README.md

# Common personal-export / contact artifacts
**/*.vcf
**/*.eml
**/*.contact

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Evaluation & Logs
logs/
*.log
*.zip
eval_results/*
!eval_results/.gitkeep
eval_results/*.json

# Node / Web artifacts (if any UI builds are added)
node_modules/
npm-debug.log*
yarn-debug.log*
.parcel-cache/

# Allow explicit project files that are safe to keep in version control
!requirements.txt
!sample_data.txt
